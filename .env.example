# Supabase — browser-safe values only.
# Both of these are shipped in the client bundle. That is expected: the anon key
# is a public identifier and Row Level Security is what actually protects data.
#
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these the site still runs, serving the static content in src/content/.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER add the service role key here or anywhere with a VITE_ prefix.
# It bypasses Row Level Security and would be readable by every visitor.
# Keep it outside the repo and only use it for one-off seed/migration scripts.
